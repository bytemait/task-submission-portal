# Generate a salted scrypt hash with the command in README
ADMIN_PASSWORD_HASH=
PORT=3001
DB_PATH=./data/submissions.sqlite
# Use 0 for local HTTP testing only; set to 1 behind HTTPS in production.
SECURE_COOKIES=0
# Exact browser origins for Vite dev proxy or reverse-proxy setups (comma-separated).
# For a same-origin production setup, no extra origins are needed.
ALLOWED_ORIGINS=http://localhost:5173
# Docker Compose publishes only to loopback by default. Keep 127.0.0.1 behind a local TLS proxy.
BIND_ADDRESS=127.0.0.1
HOST_PORT=3001
# TODO: Set to exact college enrollment format regex once confirmed (default: alphanumeric 6-20 chars)
# ENROLLMENT_REGEX=^[A-Z0-9\-/]{6,20}$
# Submission window closing time (ISO 8601). Leave empty for no closing time.
# Used client-side via VITE_SUBMISSION_CLOSE.
# VITE_SUBMISSION_CLOSE=2025-10-15T23:59:59+05:30
# Server-side submission window (ISO 8601). Writes are blocked outside this window.
# SUBMISSION_OPENS_AT=2025-09-29T00:01:00+05:30
# SUBMISSION_CLOSES_AT=               # TODO: set closing time when known

