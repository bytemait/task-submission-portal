# Generate a salted scrypt hash with the command in README
ADMIN_PASSWORD_HASH=
PORT=3001
DB_PATH=./data/submissions.sqlite
# Use 0 for local HTTP testing only; set to 1 behind HTTPS in production.
SECURE_COOKIES=0
# Exact browser origins for Vite dev proxy or reverse-proxy setups (comma-separated).
# For a same-origin production setup, no extra origins are needed.
ALLOWED_ORIGINS=http://localhost:5173
# Docker Compose publishes only to loopback by default. Keep 127.0.0.1 behind a local TLS proxy.
BIND_ADDRESS=127.0.0.1
HOST_PORT=3001
# TODO: Set to exact college enrollment format regex once confirmed (default: alphanumeric 6-20 chars)
# ENROLLMENT_REGEX=^[A-Z0-9\-/]{2,20}$
# Submission window & deadlines (ISO 8601).
# SUBMISSION_OPENS_AT=2025-09-29T00:01:00+05:30
# Filling new forms closes at (defaults to 17th Oct 2026 01:00 AM IST):
# NEW_FORMS_CLOSES_AT=2026-10-17T01:00:00+05:30
# Final submissions close at (defaults to 17th Oct 2026 01:00 AM IST; drafts stay drafts):
# SUBMISSION_CLOSES_AT=2026-10-17T01:00:00+05:30

# Client-side configuration (optional overrides)
# VITE_NEW_FORMS_CLOSE=2026-10-17T01:00:00+05:30
# VITE_SUBMISSION_CLOSE=2026-10-17T01:00:00+05:30
