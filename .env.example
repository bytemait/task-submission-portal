# Generate a salted scrypt hash with the command in README
ADMIN_PASSWORD_HASH=
PORT=3001
DB_PATH=./data/submissions.sqlite
# Use 0 for local HTTP testing only; set to 1 behind HTTPS in production.
SECURE_COOKIES=0
# Exact browser origins for Vite dev proxy or reverse-proxy setups (comma-separated).
# For a same-origin production setup, no extra origins are needed.
ALLOWED_ORIGINS=http://localhost:5173
# Docker Compose publishes only to loopback by default. Keep 127.0.0.1 behind a local TLS proxy.
BIND_ADDRESS=127.0.0.1
HOST_PORT=3001
